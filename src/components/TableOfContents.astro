---
import Default from "@astrojs/starlight/components/TableOfContents.astro";

const { id } = Astro.locals.starlightRoute;
const isBlogIndexPage = id === "blog";
const isAnyTagPage = id.includes("blog/tags");
---

{
    isBlogIndexPage || isAnyTagPage ? (
        <style>
            .right-sidebar-container {
                display: none;
            }
        </style>
    ) : (
        <Default>
            <slot />
        </Default>
    )
}
